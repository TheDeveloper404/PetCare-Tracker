        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele rămân pe acest dispozitiv. Nu există sincronizare sau backup garantat în cloud. Ștergerea aplicației poate elimina datele. Exportă periodic backupuri."
          }
        }
