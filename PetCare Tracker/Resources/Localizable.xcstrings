    "A denied permission keeps this reminder in the app. Enable notifications in Settings to receive alerts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A denied permission keeps this reminder in the app. Enable notifications in Settings to receive alerts."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă refuzi permisiunea, mementoul rămâne în aplicație. Activează notificările din Configurări pentru a primi alerte."
          }
        }
      }
    },
