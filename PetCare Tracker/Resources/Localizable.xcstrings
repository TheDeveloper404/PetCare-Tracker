    "Data stays on this device. There is no cloud sync or guaranteed cloud backup. Deleting the app may remove its data. Export backups regularly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data stays on this device. There is no cloud sync or guaranteed cloud backup. Deleting the app may remove its data. Export backups regularly."
